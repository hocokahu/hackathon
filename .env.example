# ============================================================
#  Composable AI Hackathon 2026 — env template (SAFE TO COMMIT)
#  Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# ---------- Databricks (workspace + Agent Bricks) ----------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=
DATABRICKS_ORG_ID=
DATABRICKS_EMAIL=
DATABRICKS_AUTOLOGIN_URL=
DATABRICKS_TOKEN=

# ---------- Google Cloud (Qwiklabs student project) ----------
GCP_PROJECT_ID=
GCP_USERNAME=
GCP_PASSWORD=
GCP_REGION=
GCP_ZONE=
GCP_CONSOLE_URL=

# ---------- Bloomreach Engagement (CDP) ----------
BLOOMREACH_ENGAGEMENT_URL=
BLOOMREACH_PROJECT_SLUG=
BLOOMREACH_LOGIN_EMAIL=
BLOOMREACH_LOGIN_PASSWORD=
BLOOMREACH_API_BASE_URL=
BLOOMREACH_PROJECT_TOKEN=
BLOOMREACH_API_KEY_ID=
BLOOMREACH_API_SECRET=

# ---------- Bloomreach brX (Discovery / Content) ----------
BLOOMREACH_BRX_LOGIN_URL=
BLOOMREACH_BRX_EMAIL=
BLOOMREACH_BRX_PASSWORD=

# ---------- Bloomreach Loomi Connect MCP ----------
LOOMI_CONNECT_MCP_URL=https://brx.connect.loomi.ai/mcp

# ---------- Shopify (dedicated Partner/dev org) ----------
SHOPIFY_PARTNER_EMAIL=
SHOPIFY_PARTNER_PASSWORD=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_STORE_NAME=
SHOPIFY_STORE_DOMAIN=<store>.myshopify.com
SHOPIFY_STORE_ADMIN_URL=https://admin.shopify.com/store/<store>
SHOPIFY_STOREFRONT_MCP_URL=https://<store>.myshopify.com/api/mcp
SHOPIFY_STOREFRONT_UCP_MCP_URL=https://<store>.myshopify.com/api/ucp/mcp
SHOPIFY_STORE_PASSWORD=
# Admin API custom-app token (admin > Settings > Apps and sales channels > Develop apps):
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_ADMIN_API_KEY=
SHOPIFY_ADMIN_API_SECRET=

# ============================================================
#  chat-backend / Cloud Run runtime (chat-backend/server.js)
#  Set these on the Cloud Run service (gcloud run deploy ... --set-env-vars)
#  or in .env for local runs. Blank = fill in (secret or id).
#  Prefilled = safe default; override only if needed.
# ============================================================

# ---------- Server ----------
PORT=8080
# CORS: your storefront origin (no wildcard)
ALLOWED_ORIGIN=https://<store>.myshopify.com
MAX_BODY_BYTES=10485760
MAX_IMAGE_BYTES=7340032
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_KEYS=10000
VISION_RATE_LIMIT_MAX=6

# ---------- Google Gemini ----------
# secret: AI Studio API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ---------- Databricks runtime (DATABRICKS_HOST / DATABRICKS_TOKEN above) ----------
# serverless SQL warehouse id
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SIGNALS_TABLE=workspace.default.mosaic_chat_signals
DATABRICKS_VISION_TABLE=workspace.default.mosaic_vision_reco
DATABRICKS_VISION_ENDPOINT=databricks-claude-sonnet-4-5
DATABRICKS_IMAGE_VOLUME=/Volumes/workspace/default/mosaic_images

# ---------- Shopify runtime (SHOPIFY_STORE_DOMAIN / SHOPIFY_ADMIN_API_TOKEN above) ----------
SHOPIFY_API_VERSION=2025-01
# secret: App Proxy HMAC (optional). REQUIRE_APP_PROXY=true accepts only signed calls.
SHOPIFY_APP_PROXY_SECRET=
REQUIRE_APP_PROXY=false

# ---------- Bloomreach tracking (BLOOMREACH_API_BASE_URL / BLOOMREACH_PROJECT_TOKEN above) ----------
# secret: Public API group token, for customers + customers/events tracking
BLOOMREACH_API_TOKEN=

# ---------- Vision / enrichment gating ----------
# true = allow anonymous (device_id) vision without a logged-in shopper
PUBLIC_VISION=false
# secret: protects the internal /enrich route
ENRICH_API_KEY=
