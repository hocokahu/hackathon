{
  "name": "mosaic-analyze-images",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "queue": { "enabled": true },
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": { "url": "/Volumes/workspace/default/mosaic_images/" }
  },
  "tasks": [
    {
      "task_key": "analyze",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_DATABRICKS_USER/mosaic_analyze_images",
        "source": "WORKSPACE"
      }
    }
  ]
}
