{
  "_comment": "Template for .mcp.json. Copy to .mcp.json (gitignored) and fill in the placeholders. The Databricks token is read from the shell env or .claude/settings.local.json as ${DATABRICKS_TOKEN} — never hardcode it here.",
  "mcpServers": {
    "loomi-connect": {
      "type": "http",
      "url": "https://brx.connect.loomi.ai/mcp"
    },
    "shopify-dev": {
      "command": "npx",
      "args": ["-y", "@shopify/dev-mcp@latest"]
    },
    "shopify-storefront": {
      "type": "http",
      "url": "https://<your-store>.myshopify.com/api/mcp"
    },
    "databricks-genie": {
      "type": "http",
      "url": "https://<your-databricks-host>/api/2.0/mcp/genie",
      "headers": {
        "Authorization": "Bearer ${DATABRICKS_TOKEN}"
      }
    },
    "databricks-uc-functions": {
      "type": "http",
      "url": "https://<your-databricks-host>/api/2.0/mcp/functions/<catalog>/<schema>",
      "headers": {
        "Authorization": "Bearer ${DATABRICKS_TOKEN}"
      }
    }
  }
}
